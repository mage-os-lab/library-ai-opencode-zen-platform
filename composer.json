{
    "name": "mage-os/library-ai-opencode-zen-platform",
    "description": "OpenCode Zen platform bridge for Symfony AI.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "ai",
        "bridge",
        "opencode-zen",
        "platform",
        "zen"
    ],
    "authors": [
        {
            "name": "Mage-OS Community",
            "homepage": "https://mage-os.org/"
        }
    ],
    "support": {
        "issues": "https://github.com/mage-os-lab/library-ai-opencode-zen-platform/issues",
        "source": "https://github.com/mage-os-lab/library-ai-opencode-zen-platform"
    },
    "require": {
        "php": "^8.2",
        "symfony/ai-generic-platform": "^0.13",
        "symfony/ai-platform": "^0.13",
        "symfony/http-client": "^7.3 || ^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.5"
    },
    "autoload": {
        "psr-4": {
            "MageOS\\AiOpenCodeZenPlatform\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MageOS\\AiOpenCodeZenPlatform\\Test\\": "Test/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
